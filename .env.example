ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# Supply the complete connection string only in the untracked .env or a secret manager.
ConnectionStrings__PostgreSQL=

Mirakurun__BaseUrl=http://mirakurun:40772
Mirakurun__RequestTimeoutSeconds=30

FFmpeg__ExecutablePath=/usr/bin/ffmpeg
FFmpeg__ProbeExecutablePath=/usr/bin/ffprobe
Storage__DataDirectory=/var/lib/tnlastation
# Recording destinations reported by GET /api/storages; index them from 0.
Storage__RecordedDirectories__0__Name=recorded
Storage__RecordedDirectories__0__Path=/recorded
